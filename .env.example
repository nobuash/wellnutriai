# =====================================================================
# Supabase (obrigatório)
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =====================================================================
# OpenAI (obrigatório)
# =====================================================================
OPENAI_API_KEY=sk-...

# =====================================================================
# App
# =====================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================================
# Mercado Pago (PIX e cartão avulso) — obrigatório para pagamentos MP
# =====================================================================
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_WEBHOOK_SECRET=your-mp-webhook-secret
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# =====================================================================
# Stripe (assinatura recorrente por cartão) — obrigatório para Stripe
# =====================================================================
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# =====================================================================
# E-mail de suporte (nodemailer via Gmail) — obrigatório para /support
# =====================================================================
GMAIL_USER=seuapp@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# =====================================================================
# Consentimento — suba a versão quando o texto legal mudar de forma
# relevante, isso força novo aceite dos usuários existentes.
# =====================================================================
TERMS_VERSION=1
PRIVACY_VERSION=1

# =====================================================================
# Controle de custo de IA (opcional — sem valor definido = sem limite)
# =====================================================================
AI_DAILY_BUDGET_BRL=
AI_USER_MONTHLY_BUDGET_BRL=
# Câmbio aproximado usado só para estimar custo em BRL nos logs/orçamento
USD_BRL_RATE=5.5

# =====================================================================
# Cloudflare Turnstile — NÃO IMPLEMENTADO ainda no código (o pacote
# @marsidev/react-turnstile está instalado mas não é usado em lugar
# nenhum). Deixe configurado para quando for integrado ao cadastro.
# =====================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =====================================================================
# Observabilidade — NÃO IMPLEMENTADO ainda (nenhum SDK de Sentry
# instalado). Deixe configurado para quando for integrado.
# =====================================================================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
