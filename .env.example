# =====================================================================
# Supabase (obrigatório)
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =====================================================================
# OpenAI (obrigatório)
# =====================================================================
OPENAI_API_KEY=sk-...

# =====================================================================
# Revisão regulatória — BLOQUEADOR DE LANÇAMENTO (ver docs/PRODUCTION_CHECKLIST.md)
# Em produção, a geração personalizada de plano alimentar (rota
# /api/meal-plan e edição de plano pelo chat) só funciona se esta
# variável valer exatamente "true". Ausente/qualquer outro valor =
# bloqueado, sempre — nunca aprovação por omissão. NÃO prefixar com
# NEXT_PUBLIC_: precisa continuar invisível ao client. Não afeta
# desenvolvimento/testes (só é checada quando NODE_ENV=production).
# =====================================================================
REGULATORY_REVIEW_APPROVED=

# =====================================================================
# Dados institucionais/jurídicos — BLOQUEADOR DE LANÇAMENTO
# Consumidos por src/config/legal.ts nas páginas /terms, /privacy,
# /cancellation, /data-retention. Nenhum é inventado no código — até
# serem preenchidos com dado real (e revisado por profissional
# habilitado, quando marcado), as páginas mostram um placeholder
# visível. O deploy de produção real na Vercel falha enquanto algum
# destes estiver ausente (ver next.config.js); dev/CI/preview só
# avisam. Ver docs/PRODUCTION_CHECKLIST.md para o que cada um significa.
# =====================================================================
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_CNPJ=
LEGAL_ENTITY_ADDRESS=
DPO_CONTACT_EMAIL=
SUPPORT_CONTACT_EMAIL=
LEGAL_DOCS_UPDATED_AT=
REFUND_POLICY_TEXT=
BACKUP_RETENTION_POLICY_TEXT=
LEGAL_MINIMUM_RETENTION_TEXT=

# =====================================================================
# App
# =====================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================================
# Mercado Pago (PIX e cartão avulso) — obrigatório para pagamentos MP
# =====================================================================
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_WEBHOOK_SECRET=your-mp-webhook-secret
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# =====================================================================
# Stripe (assinatura recorrente por cartão) — obrigatório para Stripe
# =====================================================================
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs pré-criados no Stripe Dashboard (Products > WellNutriAI PRO).
# Round 3: o checkout NÃO cria mais Product/Price dinamicamente — sem
# estas três variáveis, toda tentativa de assinar via Stripe falha.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_QUARTERLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# =====================================================================
# E-mail de suporte (nodemailer via Gmail) — obrigatório para /support
# =====================================================================
GMAIL_USER=seuapp@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# =====================================================================
# Consentimento — suba a versão quando o texto legal mudar de forma
# relevante, isso força novo aceite dos usuários existentes.
# =====================================================================
TERMS_VERSION=1
PRIVACY_VERSION=1

# =====================================================================
# Consentimento de dados de saúde (questionário nutricional) — BLOQUEADOR
# DE LANÇAMENTO se o jurídico decidir que consentimento é a base legal
# aplicável (LGPD art. 11). A estrutura (colunas, tabela de auditoria,
# endpoints /api/health-data-consent e /api/health-data-consent/revoke)
# já existe e funciona independente destas variáveis. Só passa a
# BLOQUEAR o envio do questionário/geração de plano quando
# HEALTH_DATA_CONSENT_REQUIRED=true — até essa decisão jurídica ser
# tomada e documentada, deixe como está (false/ausente).
# =====================================================================
HEALTH_DATA_CONSENT_VERSION=1
HEALTH_DATA_CONSENT_REQUIRED=false

# =====================================================================
# Controle de custo de IA (opcional — sem valor definido = sem limite)
# =====================================================================
AI_DAILY_BUDGET_BRL=
AI_USER_MONTHLY_BUDGET_BRL=
# Câmbio aproximado usado só para estimar custo em BRL nos logs/orçamento
USD_BRL_RATE=5.5

# =====================================================================
# Cloudflare Turnstile — NÃO IMPLEMENTADO ainda no código (o pacote
# @marsidev/react-turnstile está instalado mas não é usado em lugar
# nenhum). Deixe configurado para quando for integrado ao cadastro.
# =====================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =====================================================================
# Observabilidade — NÃO IMPLEMENTADO ainda (nenhum SDK de Sentry
# instalado). Deixe configurado para quando for integrado.
# =====================================================================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# =====================================================================
# SEO — opcional. Sem essas variáveis, nada é carregado/emitido (ver
# src/components/analytics/GoogleAnalytics.tsx e src/app/layout.tsx).
# NEXT_PUBLIC_GA_MEASUREMENT_ID: ID do GA4 (formato G-XXXXXXXXXX). Com
#   essa variável definida, o banner de consentimento de cookies passa
#   a aparecer (src/components/analytics/ConsentBanner.tsx) e o GA4 só
#   carrega depois que o usuário aceitar.
# NEXT_PUBLIC_GSC_VERIFICATION: conteúdo da meta tag de verificação de
#   propriedade do Google Search Console (Configurações > Verificação
#   de propriedade > tag HTML — copie só o valor do atributo content).
# =====================================================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
